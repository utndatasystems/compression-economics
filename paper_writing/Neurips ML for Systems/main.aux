\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Realized size ratio by input and codec.} Values are encoded bytes divided by raw UTF-8 bytes and reported as percentages; lower is better. AC payload excludes the Qwen container and is shown only for cost attribution. All entries in the four codec columns are complete, round-trip-verified streams, and bold marks the smallest complete stream per row.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:codec-comparison}{{2}{8}{\textbf {Realized size ratio by input and codec.} Values are encoded bytes divided by raw UTF-8 bytes and reported as percentages; lower is better. AC payload excludes the Qwen container and is shown only for cost attribution. All entries in the four codec columns are complete, round-trip-verified streams, and bold marks the smallest complete stream per row}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Tokenizer fertility on the held-out 5\,MB text8 test region (855{,}233 whitespace-delimited words). The text8 BPE is trained only on the first 90\,MB with a 32k vocabulary. Fertility is tokens/word (lower is better); bytes/token is the compression-oriented inverse (higher is better). All tokenizers reconstruct the input exactly. The domain-trained BPE produces 4.4\% fewer tokens than Qwen.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:tokenizer-fertility}{{3}{8}{Tokenizer fertility on the held-out 5\,MB text8 test region (855{,}233 whitespace-delimited words). The text8 BPE is trained only on the first 90\,MB with a 32k vocabulary. Fertility is tokens/word (lower is better); bytes/token is the compression-oriented inverse (higher is better). All tokenizers reconstruct the input exactly. The domain-trained BPE produces 4.4\% fewer tokens than Qwen}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Guarded layered compression pipeline.} Hot blocks retain queryable token IDs. At cold eviction, both complete encodings are produced and the smaller is stored with a codec tag. On access, either path restores token IDs before token-table query execution.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:block-guard-pipeline}{{3}{8}{\textbf {Guarded layered compression pipeline.} Hot blocks retain queryable token IDs. At cold eviction, both complete encodings are produced and the smaller is stored with a codec tag. On access, either path restores token IDs before token-table query execution}{figure.3}{}}
